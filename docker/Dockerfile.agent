FROM python:3.12-slim

WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends curl whois dnsutils \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY agent ./agent
COPY osint ./osint
COPY config ./config

RUN pip install --no-cache-dir -e .

ENV PYTHONUNBUFFERED=1
CMD ["precog", "doctor"]
